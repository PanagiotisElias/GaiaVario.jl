date-released: 2026-10-30
license: AGPL-3.0-only
repository-code: "https://github.com/PanagiotisElias/GaiaVario.jl"
url: "https://github.com/PanagiotisElias/GaiaVario.jl"
doi: 10.5281/zenodo.23810265
authors:
  - family-names: Elias
    given-names: Panagiotis
